# Copy this file to .env and fill in real local values.
# Never commit the real .env file.

APP_NAME=commerce-platform-api
APP_ENV=development
DEBUG=true

# Application database. Must point at the dedicated "commerce_platform"
# database, NOT the pre-existing "ecommerce" database.
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/commerce_platform

# Database used exclusively by the automated test suite. Also must point
# at a "commerce_platform"-scoped database (e.g. a "_test" suffix), never
# at "ecommerce".
TEST_DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/commerce_platform_test

LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Signing key for access tokens. Required - the application refuses to start
# without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this value invalidates every access token already issued.
JWT_SECRET_KEY=replace-me-with-a-generated-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Supabase Storage holds product image files; PostgreSQL holds only metadata.
# Both of the following are required - the application refuses to start
# without them. The service-role key is a secret and stays server-side; it is
# never handed to a client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=replace-me-with-the-service-role-key

# The bucket must be created as PRIVATE. Images are served through
# short-lived signed URLs generated per request, not through public links.
SUPABASE_PRODUCT_IMAGE_BUCKET=product-images
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=3600
